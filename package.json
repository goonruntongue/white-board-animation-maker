{
  "name": "whiteboard-animation-maker",
  "productName": "Whiteboard Animation Maker",
  "version": "0.1.3",
  "description": "ホワイトボード清書画像から「手が描いていく」アニメーションを作るデスクトップアプリ",
  "main": "./out/main/index.js",
  "author": "goonruntongue",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "icons:pwa": "python scripts/make-pwa-icons.py assets/icon/app-icon-hand.png src/renderer/public/icons",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.goonruntongue.whiteboard-animation-maker",
    "productName": "Whiteboard Animation Maker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon/app-icon-hand.ico",
        "to": "app-icon.ico"
      }
    ],
    "fileAssociations": [
      {
        "ext": "wbanim",
        "name": "Whiteboard Animation Project",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "assets/icon/app-icon-hand.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "WhiteboardAnimationMaker-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/icon/app-icon-mac.png",
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "WhiteboardAnimationMaker-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Whiteboard Animation Maker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon/app-icon-mac.png",
      "category": "Graphics",
      "artifactName": "WhiteboardAnimationMaker-linux-x86_64.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "zustand": "^5.1.0"
  }
}
